<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd">

    
    <bean  class="in.study.spring.beans.Address" id="addObj">
        <property name="state" value="Maharashtra"/>
        <property name="district" value="Jalgaon"/>
        <property name="pincode" value="425201"/>
        <property name="tal" value="Bhusawal"/>
        
    </bean>
    
    <bean  class="in.study.spring.beans.Student" id="stdObj">
        <property name="id" value="1"/>
        <property name="name" value="sagar"/>
        <property name="email" value="sagar@gmail.com"/>
        <property name="address" ref="addObj"/>              	
        
     </bean>
    
     

</beans>